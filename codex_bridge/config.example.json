{
  "env_file": "~/.codex/discord/.env",
  "allowed_users": ["YOUR_DISCORD_USER_ID"],
  "sessions_file": "codex_sessions.json",
  "daily_reset_hour": 7,
  "channels": {
    "CHANNEL_ID": {
      "name": "codex-main",
      "session_group": "codex-main",
